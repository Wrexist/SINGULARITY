{
  "name": "singularity-inc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "vite-node scripts/balance-sim.ts",
    "shot": "node scripts/screenshot.mjs",
    "validate:store": "node scripts/validate-store-metadata.mjs",
    "icons": "node scripts/stamp-icons.mjs",
    "cap:sync": "npm run build && node scripts/ios-prepare.mjs && cap sync ios",
    "cap:sync:dev": "tsc --noEmit && vite build --mode development && node scripts/ios-prepare.mjs && cap sync ios",
    "trailer:score": "node scripts/trailer/score.mjs"
  },
  "dependencies": {
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6",
    "@revenuecat/purchases-capacitor": "11.3.2",
    "@revenuecat/purchases-capacitor-ui": "11.3.2",
    "break_infinity.js": "^2.0.0",
    "cordova-plugin-purchase": "^13.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "@revenuecat/purchases-capacitor-ui": {
      "@revenuecat/purchases-capacitor": "$@revenuecat/purchases-capacitor"
    }
  }
}
